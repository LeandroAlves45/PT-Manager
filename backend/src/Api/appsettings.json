{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AuthCookies": {
    "SameSite": "Lax"
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Jwt": {
    "Issuer": "https://api.ptmanager.local",
    "Audience": "ptmanager.spa",
    "ClockSkew": "00:00:30"
  },
  "Resend": {
    "BaseAddress": "https://api.resend.com/",
    "Timeout": "00:00:10"
  },
  "JobDispatch": {
    "JobBatchSize": 20,
    "OutboxBatchSize": 20,
    "MaxConcurrencyPerDispatcher": 2,
    "ActivationTimeout": "00:00:30",
    "LeaseDuration": "00:01:00",
    "LeaseRenewalInterval": "00:00:20",
    "MaxAttempts": 5,
    "InitialRetryDelay": "00:01:00",
    "MaximumRetryDelay": "01:00:00",
    "MaximumJitterRatio": 0.2
  },
  "QStash": {
    "Enabled": false,
    "MaximumBodySize": 4096,
    "ClockSkew": "00:00:30",
    "MaximumTokenLifetime": "00:10:00",
    "ReplayRetention": "1.00:00:00"
  },
  "Stripe": {
    "Enabled": false,
    "Timeout": "00:00:30",
    "MaxNetworkRetries": 2,
    "SignatureTolerance": "00:05:00",
    "MaximumWebhookBodySize": 262144,
    "CheckoutSessionLifetime": "00:30:00"
  },
  "Cloudinary": {
    "Enabled": false,
    "FolderRoot": "pt-manager",
    "BaseAddress": "https://api.cloudinary.com/",
    "Timeout": "00:00:20"
  },
  "Vision": {
    "Enabled": false,
    "BaseAddress": "https://vision.googleapis.com/",
    "Timeout": "00:00:05"
  },
  "AllowedHosts": "*"
}
