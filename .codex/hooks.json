{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear)$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/.codex/hooks/run-hook.ps1\" \"session-start\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/run-hook.ps1') 'session-start'\"",
            "timeout": 5,
            "statusMessage": "A carregar o contexto do projeto..."
          }
        ]
      },
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/.codex/hooks/run-hook.ps1\" \"context-recovery\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/run-hook.ps1') 'context-recovery'\"",
            "timeout": 5,
            "statusMessage": "A recuperar as regras essenciais..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/.codex/hooks/run-hook.ps1\" \"pre-file-policy\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/run-hook.ps1') 'pre-file-policy'\"",
            "timeout": 10,
            "statusMessage": "A validar os ficheiros da alteração..."
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/.codex/hooks/run-hook.ps1\" \"pre-shell\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/run-hook.ps1') 'pre-shell'\"",
            "timeout": 5,
            "statusMessage": "A validar o comando..."
          }
        ]
      }
    ]
  }
}
