{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/run-hook.cmd session-init.sh"
      },
      {
        "command": ".cursor/hooks/run-hook.cmd context-inject.sh"
      }
    ],
    "afterMCPExecution": [
      {
        "command": ".cursor/hooks/run-hook.cmd save-observation.sh"
      }
    ],
    "afterShellExecution": [
      {
        "command": ".cursor/hooks/run-hook.cmd save-observation.sh"
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/run-hook.cmd save-file-edit.sh"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/run-hook.cmd session-summary.sh"
      }
    ]
  }
}
