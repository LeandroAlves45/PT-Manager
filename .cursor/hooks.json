{
  "version": 1,
  "hooks": {
    "afterMCPExecution": [
      {
        "command": ".cursor/hooks/run-if-memory-on.cmd save-observation.sh",
        "timeout": 8
      }
    ],
    "afterShellExecution": [
      {
        "command": ".cursor/hooks/run-if-memory-on.cmd save-observation.sh",
        "timeout": 8
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/run-if-memory-on.cmd save-file-edit.sh",
        "timeout": 8
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/run-if-memory-on.cmd session-summary.sh",
        "timeout": 8
      }
    ]
  }
}
